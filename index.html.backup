    <button class="chart-modal-close" onclick="closeChartModal()">×</button>
    <div class="chart-modal-title" id="modalChartTitle"></div>
    <div class="chart-modal-canvas-wrap">
      <canvas id="modalChart"></canvas>
    </div>
  </div>
</div>

<!-- Chart Context Menu -->
<div class="chart-context-menu" id="chartContextMenu">
  <div class="chart-context-menu-item" onclick="saveChartAsImage('png')">
    💾 Save as PNG
  </div>
  <div class="chart-context-menu-item" onclick="copyChartImage()">
    📋 Copy Chart
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
const isDark = () => {
  // Force light theme - always return false
  return false;
};

const grid = () => isDark() ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.04)';
const tick = () => isDark() ? '#94a3b8' : '#64748b';

const opts = (extra = {}) => Object.assign({
  responsive: true,
  maintainAspectRatio: false,
  plugins: {
    legend: { display: false },
    tooltip: {
      enabled: true,
      backgroundColor: isDark() ? 'rgba(30,30,30,0.95)' : 'rgba(255,255,255,0.95)',
      titleColor: isDark() ? '#fff' : '#000',
      bodyColor: isDark() ? '#fff' : '#000',
      borderColor: isDark() ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
      borderWidth: 1,
      padding: 12,
      displayColors: true,
      callbacks: {
        title: function(context) {
          return context[0].label;
        },
        label: function(context) {
          let label = context.dataset.label || '';
          if (label) {
            label += ': ';
          }
          label += context.parsed.y.toLocaleString();
          return label;
        }
      }
    }
  },
  scales: {
    x: {
      grid: { color: grid() },
      ticks: { color: tick(), font: { size: 9, weight: 'bold' } },
      border: { color: tick(), width: 1.5 }
    },
    y: {
      grid: { color: grid() },
      ticks: { color: tick(), font: { size: 9, weight: 'bold' } },
      border: { color: tick(), width: 1.5 }
    }
  },
  interaction: {
    mode: 'index',
    intersect: false
  }
}, extra);

function switchTab(e, id) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  e.target.classList.add('active');
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  load(id);
}

function refresh() {
  const active = document.querySelector('.tab-panel.active');
  if (active) {
    active.querySelectorAll('canvas').forEach(c => {
      if (c.chart) {
        c.chart.destroy();
        c.chart = null;
      }
    });
    load(active.id);
  }
}

function load(id) {
  switch(id) {
    case 'overview': loadOverview(); break;
    case 'production': loadProduction(); break;
    case 'losses': loadLosses(); break;
    case 'wells': loadWells(); break;
    case 'gains': loadGains(); break;
    case 'flowback': loadFlowback(); break;
    case 'leakage': loadLeakage(); break;
  }
}

const dates = () => Array.from({length: 30}, (_, i) => {
  const d = new Date(2026, 5, i + 1);
  return d.toLocaleDateString('en-US', {month: 'short', day: 'numeric'});
});

const r = (lo, hi) => lo + Math.random() * (hi - lo);
const ri = (lo, hi) => Math.round(r(lo, hi));
const pick = arr => arr[Math.floor(Math.random() * arr.length)];

const WELLS = ['SV#1','SV#2','SV#3','SV#4','SV#5','SV#6','SV#7','SV#8','SV#9','SV#10','SV#11','SV#12',
  'S1-1#1','S1-2#1','S1-3#1','S1-4#1','S1-5#1','S1-6#1','S1-7#1','S1-8#1'];

// API Configuration
const API_BASE = 'http://localhost:5001/api';

// API fetch wrapper
async function fetchAPI(endpoint, params = {}) {
  const url = new URL(`${API_BASE}${endpoint}`);
  Object.keys(params).forEach(key => {
    if (params[key] !== null && params[key] !== undefined) {
      url.searchParams.append(key, params[key]);
    }
  });

  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`API error: ${response.status}`);
    const result = await response.json();
    return result.data || result;
  } catch (error) {
    console.error('API fetch failed:', error);
    return null;
  }
}

// Helper function to create comparison data display
function updateComparison(compId, startValue, endValue, unit = 'BOPD') {
  const compDiv = document.getElementById(compId);
  if (!compDiv) return;

  const diff = endValue - startValue;
  const percentChange = startValue !== 0 ? ((diff / startValue) * 100) : 0;
  const changeClass = diff >= 0 ? 'positive' : 'negative';
  const sign = diff >= 0 ? '+' : '-';

  // Format values based on unit - use 3 decimals for gas (MMSCMD), round for others
  const isGas = unit === 'MMSCMD';
  const formatValue = (val) => isGas ? val.toFixed(3) : Math.round(val).toLocaleString();
  const formatDiff = (val) => isGas ? Math.abs(val).toFixed(3) : Math.abs(Math.round(val)).toLocaleString();

  compDiv.innerHTML = `
    <div class="comparison-item">
      <span class="comparison-label">Start:</span>
      <span class="comparison-value">${formatValue(startValue)} ${unit}</span>
    </div>
    <div class="comparison-item">
      <span class="comparison-label">End:</span>
      <span class="comparison-value">${formatValue(endValue)} ${unit}</span>
    </div>
    <div class="comparison-item">
      <span class="comparison-label">Change:</span>
      <span class="comparison-change ${changeClass}">
        ${sign}${formatDiff(diff)} ${unit} (${sign}${Math.abs(percentChange).toFixed(1)}%)
      </span>
    </div>
  `;
}

// Chart interaction variables
let currentContextMenuCanvas = null;
let modalChartInstance = null;

// Click-to-zoom: Open chart in modal
function openChartModal(canvasId, chartTitle) {
  const sourceCanvas = document.getElementById(canvasId);
  if (!sourceCanvas || !sourceCanvas.chart) return;

  const modal = document.getElementById('chartModal');
  const modalCanvas = document.getElementById('modalChart');
  const titleElement = document.getElementById('modalChartTitle');

  // Set title
  titleElement.textContent = chartTitle;

  // Destroy previous modal chart if exists
  if (modalChartInstance) {
    modalChartInstance.destroy();
  }

  // Clone the chart configuration - deep clone that preserves colors and gradients
  const sourceChart = sourceCanvas.chart;
  const sourceData = sourceChart.data;

  // Deep clone data, preserving colors and non-serializable properties
  const clonedData = {
    labels: [...sourceData.labels],
    datasets: sourceData.datasets.map(ds => {
      const clonedDs = {
        label: ds.label,
        data: [...ds.data],
        borderColor: ds.borderColor,
        backgroundColor: ds.backgroundColor,
        fill: ds.fill,
        tension: ds.tension,
        borderWidth: ds.borderWidth,
        pointRadius: ds.pointRadius,
        pointHoverRadius: ds.pointHoverRadius,
        pointBackgroundColor: ds.pointBackgroundColor,
        pointBorderColor: ds.pointBorderColor
      };

      // If backgroundColor is a gradient object, recreate it for modal canvas
      if (ds.backgroundColor && typeof ds.backgroundColor === 'object' && ds.backgroundColor.addColorStop) {
        // Extract color from borderColor and create new gradient
        const ctx = modalCanvas.getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        const baseColor = ds.borderColor || '#0284c7';
        gradient.addColorStop(0, baseColor + '40');
        gradient.addColorStop(1, baseColor + '08');
        clonedDs.backgroundColor = gradient;
      }

      return clonedDs;
    })
  };

  // Clone options
  const clonedOptions = JSON.parse(JSON.stringify(sourceChart.config.options));

  const config = {
    type: sourceChart.config.type,
    data: clonedData,
    options: clonedOptions
  };

  // Create new chart in modal
  modalChartInstance = new Chart(modalCanvas, config);

  // Show modal
  modal.classList.add('active');

  // Close on background click
  modal.onclick = (e) => {
    if (e.target === modal) {
      closeChartModal();
    }
  };

  // Close on Escape key
  document.addEventListener('keydown', closeOnEscape);
}

function closeOnEscape(e) {
  if (e.key === 'Escape') {
    closeChartModal();
  }
}

function closeChartModal() {
  const modal = document.getElementById('chartModal');
  modal.classList.remove('active');

  // Destroy modal chart
  if (modalChartInstance) {
    modalChartInstance.destroy();
    modalChartInstance = null;
  }

  document.removeEventListener('keydown', closeOnEscape);
}

// Right-click context menu
function setupChartContextMenu(canvasId) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;

  canvas.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    currentContextMenuCanvas = canvas;

    const menu = document.getElementById('chartContextMenu');
    menu.style.left = e.pageX + 'px';
    menu.style.top = e.pageY + 'px';
    menu.classList.add('active');
  });
}

// Hide context menu on click outside
document.addEventListener('click', () => {
  const menu = document.getElementById('chartContextMenu');
  menu.classList.remove('active');
});

// Save chart as image
function saveChartAsImage(format = 'png') {
  if (!currentContextMenuCanvas || !currentContextMenuCanvas.chart) return;

  const canvas = currentContextMenuCanvas;
  const chart = canvas.chart;

  // Get chart title for filename
  const titleElement = canvas.closest('.chart-box').querySelector('.chart-title span');
  const chartTitle = titleElement ? titleElement.textContent.replace(/\s+/g, '_') : 'chart';

  // Convert canvas to blob
  canvas.toBlob((blob) => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${chartTitle}_${new Date().toISOString().split('T')[0]}.${format}`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }, `image/${format}`);

  // Hide menu
  document.getElementById('chartContextMenu').classList.remove('active');
}

// Copy chart with embedded data
async function copyChartWithData() {
  if (!currentContextMenuCanvas || !currentContextMenuCanvas.chart) return;

  const canvas = currentContextMenuCanvas;
  const chart = canvas.chart;

  try {
    // Get chart image as blob
    const blob = await new Promise(resolve => {
      canvas.toBlob(resolve, 'image/png');
    });

    // Get chart data as HTML table
    const data = chart.data;
    let htmlTable = '<table border="1" style="border-collapse: collapse;">';

    // Header row
    htmlTable += '<tr>';
    htmlTable += '<th style="padding: 4px; background: #f0f0f0; font-weight: bold;">Date</th>';
    data.datasets.forEach(dataset => {
      htmlTable += `<th style="padding: 4px; background: #f0f0f0; font-weight: bold;">${dataset.label || 'Value'}</th>`;
    });
    htmlTable += '</tr>';

    // Data rows
    data.labels.forEach((label, index) => {
      htmlTable += '<tr>';
      htmlTable += `<td style="padding: 4px;">${label}</td>`;
      data.datasets.forEach(dataset => {
        const value = dataset.data[index] || 0;
        htmlTable += `<td style="padding: 4px; text-align: right;">${Math.round(value).toLocaleString()}</td>`;
      });
      htmlTable += '</tr>';
    });
    htmlTable += '</table>';

    // Create clipboard items with both image and HTML data
    const clipboardItems = [
      new ClipboardItem({
        'image/png': blob,
        'text/html': new Blob([htmlTable], { type: 'text/html' }),
        'text/plain': new Blob([htmlTable.replace(/<[^>]*>/g, '\t').replace(/\t+/g, '\t')], { type: 'text/plain' })
      })
    ];

    // Copy to clipboard
    await navigator.clipboard.write(clipboardItems);

    // Show success message
    alert('Chart and data copied to clipboard! You can now paste it into Excel, Word, or any other application.');

  } catch (error) {
    console.error('Copy failed:', error);
    alert('Failed to copy chart. Please try saving as image instead.');
  }

  // Hide menu
  document.getElementById('chartContextMenu').classList.remove('active');
}

// Alias for backward compatibility with HTML onclick handler
const copyChartImage = copyChartWithData;

// Export chart data to Excel via backend API
async function exportChartData(canvasId, filename) {
  const canvas = document.getElementById(canvasId);
  if (!canvas || !canvas.chart) {
    alert('Chart data not available. Please wait for the chart to load.');
    return;
  }

  const chart = canvas.chart;
  const data = chart.data;

  // Prepare data for export
  const exportData = [];

  // Add header row
  const headers = ['Date'];
  data.datasets.forEach(dataset => {
    headers.push(dataset.label || 'Value');
  });
  exportData.push(headers);

  // Helper function to convert date label to dd-mm-yyyy format
  function formatDateForExport(label) {
    // If rawDates are stored on the chart, use them
    if (chart.rawDates && chart.rawDates.length > 0) {
      const index = data.labels.indexOf(label);
      if (index >= 0 && index < chart.rawDates.length) {
        const date = new Date(chart.rawDates[index]);
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}-${month}-${year}`;
      }
    }

    // Fallback: try to parse the label (e.g., "Nov 21" format)
    // Get current year from the date range
    const currentYear = new Date().getFullYear();
    try {
      // Parse "Nov 21" format
      const date = new Date(`${label} ${currentYear}`);
      if (!isNaN(date.getTime())) {
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}-${month}-${year}`;
      }
    } catch (e) {
      console.warn('Could not parse date:', label);
    }

    // If all else fails, return the original label
    return label;
  }

  // Add data rows
  data.labels.forEach((label, index) => {
    const formattedDate = formatDateForExport(label);
    const row = [formattedDate];
    data.datasets.forEach(dataset => {
      row.push(dataset.data[index] || 0);
    });
    exportData.push(row);
  });

  try {
    // Send data to backend for Excel generation with formatting
    const response = await fetch('http://localhost:5001/api/export/chart', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        data: exportData,
        filename: filename
      })
    });

    if (!response.ok) {
      throw new Error('Export failed');
    }

    // Get the blob from response
    const blob = await response.blob();

    // Create download link
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;

    // Get filename from response header or use default
    const contentDisposition = response.headers.get('content-disposition');
    let downloadFilename = filename + '_' + new Date().toISOString().split('T')[0] + '.xlsx';
    if (contentDisposition) {
      const filenameMatch = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
      if (filenameMatch && filenameMatch[1]) {
        downloadFilename = filenameMatch[1].replace(/['"]/g, '');
      }
    }

    a.download = downloadFilename;
    document.body.appendChild(a);
    a.click();
    window.URL.revokeObjectURL(url);
    document.body.removeChild(a);

  } catch (error) {
    console.error('Export error:', error);
    alert('Failed to export data. Please ensure the backend server is running.');
  }
}

async function loadOverview(startDateParam = null, endDateParam = null, prodDateParam = null) {
  // Use provided parameters if available, otherwise read from DOM inputs
  const startDate = startDateParam || document.getElementById('start').value;
  const endDate = endDateParam || document.getElementById('end').value;
  const prodDate = prodDateParam || document.getElementById('prodDate').value;

  console.log('loadOverview called with dates:', {startDate, endDate, prodDate, fromParams: !!startDateParam});

  // Fetch summary for KPIs using ONLY the production date (single day)
  const summary = await fetchAPI('/dashboard/summary', {start_date: prodDate, end_date: prodDate});
  if (summary && (summary.production || (summary.data && summary.data.production))) {
    const prod = summary.production || summary.data.production;
    console.log('Fetched production data:', prod);
    document.getElementById('kpi-oil').innerHTML = `${Math.round(prod.total_oil_bopd).toLocaleString()} <span class="kpi-unit">BOPD</span>`;
    document.getElementById('kpi-gas').innerHTML = `${prod.total_gas_mmscm.toFixed(1)} <span class="kpi-unit">MMSCMD</span>`;
    document.getElementById('kpi-wi').innerHTML = `${Math.round(prod.total_wi_bwpd).toLocaleString()} <span class="kpi-unit">BWPD</span>`;

    // Display individual performance values
    const oilPerf = prod.oil_performance_percent || 0;
    const gasPerf = prod.gas_performance_percent || 0;
    document.getElementById('kpi-oil-perf').innerHTML = `Performance: ${oilPerf.toFixed(1)}%`;
    document.getElementById('kpi-oil-perf').className = oilPerf >= 100 ? 'kpi-change up' : (oilPerf >= 90 ? 'kpi-change' : 'kpi-change down');
    document.getElementById('kpi-gas-perf').innerHTML = `Performance: ${gasPerf.toFixed(1)}%`;
    document.getElementById('kpi-gas-perf').className = gasPerf >= 100 ? 'kpi-change up' : (gasPerf >= 90 ? 'kpi-change' : 'kpi-change down');
  }

  // Fetch daily production data for the date range
  const productionData = await fetchAPI('/production/daily', {start_date: startDate, end_date: endDate});
  if (!productionData) return;

  // Fetch complex-wise trend data from the new API endpoint
  const response = await fetchAPI('/production/complex/trends', {start_date: startDate, end_date: endDate});
  const complexData = response ? (response.data || response) : null;

  const complexes = [
    {id: 'MHN', name: 'MHN', color: '#10b981', area: 'North'},
    {id: 'NQO', name: 'NQO', color: '#34d399', area: 'North'},
    {id: 'BHS', name: 'BHS', color: '#f59e0b', area: 'South'},
    {id: 'SCA', name: 'SCA', color: '#fbbf24', area: 'South'},
    {id: 'SHP', name: 'SHP', color: '#0ea5e9', area: 'South'},
    {id: 'ICP', name: 'ICP', color: '#38bdf8', area: 'South'},
    {id: 'CL7', name: 'CL-7', color: '#8b5cf6', area: 'Marginal'},
    {id: 'WO16', name: 'WO-16', color: '#a78bfa', area: 'Marginal'}
  ];


  // Group by date for main production trends
  const byDate = {};
  productionData.forEach(row => {
    if (!byDate[row.production_date]) {
      byDate[row.production_date] = {north: {}, south: {}};
    }
    if (row.complex_name === 'MH North') {
      byDate[row.production_date].north = row;
    } else {
      byDate[row.production_date].south = row;
    }
  });

  const dates = Object.keys(byDate).sort();
  const labels = dates.map(d => {
    const dt = new Date(d);
    return dt.toLocaleDateString('en-US', {month: 'short', day: 'numeric'});
  });

  // Calculate totals for each date
  const oilData = dates.map(d => (byDate[d].north.oil_bopd || 0) + (byDate[d].south.oil_bopd || 0));
  const gasData = dates.map(d => (byDate[d].north.gas_mmscm || 0) + (byDate[d].south.gas_mmscm || 0));
  const wiData = dates.map(d => (byDate[d].north.wi_bwpd || 0) + (byDate[d].south.wi_bwpd || 0));

  // Oil Production Trend
  const c1 = document.getElementById('c1');
  if (c1 && !c1.chart) {
    c1.chart = new Chart(c1, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {label: 'Oil (BOPD)', data: oilData, borderColor: '#15803d', backgroundColor: 'rgba(21,128,61,0.08)', fill: true, tension: 0.4, borderWidth: 2, pointRadius: 0}
        ]
      },
      options: opts({plugins: {legend: {display: false}}})
    });
    // Store raw dates for export
    c1.chart.rawDates = dates;
    // Add click-to-zoom and right-click context menu
    c1.classList.add('chart-clickable');
    c1.onclick = (e) => { if (!e.target.closest('.export-btn')) openChartModal('c1', 'MH Total Oil Production'); };
    setupChartContextMenu('c1');
    // Update comparison for Oil trend
    if (oilData.length > 1) {
      updateComparison('comp-c1', oilData[0], oilData[oilData.length - 1], 'BOPD');
    }
  } else if (c1 && c1.chart) {
    c1.chart.data.labels = labels;
    c1.chart.data.datasets[0].data = oilData;
    c1.chart.rawDates = dates;
    c1.chart.update();
    // Update comparison for Oil trend
    if (oilData.length > 1) {
      updateComparison('comp-c1', oilData[0], oilData[oilData.length - 1], 'BOPD');
    }
  }

  // Gas Production Trend
  const c1b = document.getElementById('c1b');
  if (c1b && !c1b.chart) {
    c1b.chart = new Chart(c1b, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {label: 'Gas (MMSCMD)', data: gasData, borderColor: '#0284c7', backgroundColor: 'rgba(2,132,199,0.08)', fill: true, tension: 0.4, borderWidth: 2, pointRadius: 0}
        ]
      },
      options: opts({plugins: {legend: {display: false}}})
    });
    // Store raw dates for export
    c1b.chart.rawDates = dates;
    // Add click-to-zoom and right-click context menu
    c1b.classList.add('chart-clickable');
    c1b.onclick = (e) => { if (!e.target.closest('.export-btn')) openChartModal('c1b', 'MH Total Gas Production'); };
    setupChartContextMenu('c1b');
    // Update comparison for Gas trend
    if (gasData.length > 1) {
      updateComparison('comp-c1b', gasData[0], gasData[gasData.length - 1], 'MMSCMD');
    }
  } else if (c1b && c1b.chart) {
    c1b.chart.data.labels = labels;
    c1b.chart.data.datasets[0].data = gasData;
    c1b.chart.rawDates = dates;
    c1b.chart.update();
    // Update comparison for Gas trend
    if (gasData.length > 1) {
      updateComparison('comp-c1b', gasData[0], gasData[gasData.length - 1], 'MMSCMD');
    }
  }

  // Water Injection Trend
  const c1w = document.getElementById('c1w');
  if (c1w && !c1w.chart) {
    c1w.chart = new Chart(c1w, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {label: 'WI (BWPD)', data: wiData, borderColor: '#7c3aed', backgroundColor: 'rgba(124,58,237,0.08)', fill: true, tension: 0.4, borderWidth: 2, pointRadius: 0}
        ]
      },
      options: opts({plugins: {legend: {display: false}}})
    });
    // Store raw dates for export
    c1w.chart.rawDates = dates;
    // Add click-to-zoom and right-click context menu
    c1w.classList.add('chart-clickable');
    c1w.onclick = (e) => { if (!e.target.closest('.export-btn')) openChartModal('c1w', 'MH Total Water Injection'); };
    setupChartContextMenu('c1w');
    // Update comparison for WI trend
    if (wiData.length > 1) {
      updateComparison('comp-c1w', wiData[0], wiData[wiData.length - 1], 'BWPD');
    }
  } else if (c1w && c1w.chart) {
    c1w.chart.data.labels = labels;
    c1w.chart.data.datasets[0].data = wiData;
    c1w.chart.rawDates = dates;
    c1w.chart.update();
    // Update comparison for WI trend
    if (wiData.length > 1) {
      updateComparison('comp-c1w', wiData[0], wiData[wiData.length - 1], 'BWPD');
    }
  }

  // Complex-wise Production Trends
  await loadComplexWiseTrends(startDate, endDate);
}

// Load complex-wise production trends for all 8 complexes over the date range
async function loadComplexWiseTrends(startDateParam = null, endDateParam = null) {
  const startDate = startDateParam || document.getElementById('start').value;
  const endDate = endDateParam || document.getElementById('end').value;

  console.log('loadComplexWiseTrends called with:', {startDate, endDate});

  // Fetch complex-wise trend data from the API endpoint
  const response = await fetchAPI('/production/complex/trends', {start_date: startDate, end_date: endDate});
  console.log('API response:', response);

  if (!response) {
    console.error('No data received from API');
    return;
  }

  const complexData = response;
  console.log('Complex data received:', Object.keys(complexData));

  const complexes = [
    {id: 'MHN', name: 'MHN', color: '#10b981', area: 'North'},
    {id: 'NQO', name: 'NQO', color: '#34d399', area: 'North'},
    {id: 'BHS', name: 'BHS', color: '#f59e0b', area: 'South'},
    {id: 'SCA', name: 'SCA', color: '#fbbf24', area: 'South'},
    {id: 'SHP', name: 'SHP', color: '#0ea5e9', area: 'South'},
    {id: 'ICP', name: 'ICP', color: '#38bdf8', area: 'South'},
    {id: 'CL7', name: 'CL-7', color: '#8b5cf6', area: 'Marginal'},
    {id: 'WO16', name: 'WO-16', color: '#a78bfa', area: 'Marginal'}
  ];

  // Create area charts for each complex
  complexes.forEach(cx => {
    const canvas = document.getElementById(`cx${cx.id}`);
    console.log(`Processing ${cx.id}, canvas found:`, !!canvas);

    if (!canvas) return;

    const cxData = complexData[cx.id];
    if (!cxData) {
      console.error(`No data for complex ${cx.id}`);
      return;
    }

    console.log(`${cx.id} has ${cxData.dates.length} dates, ${cxData.oil.length} oil values`);

    // Format dates for display
    const labels = cxData.dates.map(d => {
      const dt = new Date(d);
      return dt.toLocaleDateString('en-US', {month: 'short', day: 'numeric'});
    });

    if (canvas.chart) {
      // Update existing chart
      console.log(`Updating existing chart for ${cx.id}`);
      canvas.chart.data.labels = labels;
      canvas.chart.data.datasets[0].data = cxData.oil;
      canvas.chart.rawDates = cxData.dates;
      canvas.chart.update();
      canvas.classList.add('chart-clickable');
      canvas.onclick = (e) => { if (!e.target.closest('.export-btn')) openChartModal(`cx${cx.id}`, cx.name + ' Oil Production'); };
      setupChartContextMenu(`cx${cx.id}`);
      // Update comparison
      if (cxData.oil.length > 1) {
        updateComparison(`comp-cx${cx.id}`, cxData.oil[0], cxData.oil[cxData.oil.length - 1], 'BOPD');
      }
    } else {
      // Create new area chart with gradient
      console.log(`Creating new chart for ${cx.id}`);
      const ctx = canvas.getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 0, 200);
      gradient.addColorStop(0, cx.color + '40'); // 25% opacity at top
      gradient.addColorStop(1, cx.color + '08'); // 3% opacity at bottom

      canvas.chart = new Chart(canvas, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: cx.name + ' Oil (BOPD)',
            data: cxData.oil,
            borderColor: cx.color,
            backgroundColor: gradient,
            fill: true,
            tension: 0.4,
            borderWidth: 2.5,
            pointRadius: 3,
            pointBackgroundColor: cx.color,
            pointBorderColor: '#fff',
            pointBorderWidth: 1.5,
            pointHoverRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          onClick: (event, elements) => {
            if (elements.length > 0) {
              const dataIndex = elements[0].index;
              const label = labels[dataIndex];
              const value = cxData.oil[dataIndex];
              alert(`Date: ${label}\n${cx.name} Oil: ${Math.round(value).toLocaleString()} BOPD`);
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              enabled: true,
              mode: 'index',
              intersect: false,
              backgroundColor: isDark() ? 'rgba(30,30,30,0.95)' : 'rgba(255,255,255,0.95)',
              titleColor: isDark() ? '#fff' : '#000',
              bodyColor: isDark() ? '#fff' : '#000',
              borderColor: isDark() ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
              borderWidth: 1,
              padding: 10,
              callbacks: {
                title: function(context) {
                  return 'Date: ' + context[0].label;
                },
                label: function(context) {
                  return cx.name + ': ' + Math.round(context.parsed.y).toLocaleString() + ' BOPD';
                }
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: '#000', font: { size: 9, weight: 'bold' } },
              border: { color: '#000', width: 1.5 }
            },
            y: {
              grid: { color: grid() },
              ticks: { color: '#000', font: { size: 9, weight: 'bold' } },
              border: { color: '#000', width: 1.5 }
            }
          }
        }
      });
      console.log(`Chart created for ${cx.id}`);
      // Add click-to-zoom and right-click context menu
      canvas.classList.add('chart-clickable');
      canvas.onclick = (e) => { if (!e.target.closest('.export-btn')) openChartModal(`cx${cx.id}`, cx.name + ' Oil Production'); };
      setupChartContextMenu(`cx${cx.id}`);
      // Update comparison for newly created chart
      if (cxData.oil.length > 1) {
        updateComparison(`comp-cx${cx.id}`, cxData.oil[0], cxData.oil[cxData.oil.length - 1], 'BOPD');
      }
    }
  });

  // Create gas charts for each complex
  complexes.forEach(cx => {
    const canvasGas = document.getElementById(`cx${cx.id}Gas`);
    console.log(`Processing ${cx.id} Gas, canvas found:`, !!canvasGas);

    if (!canvasGas) return;

    const cxData = complexData[cx.id];
    if (!cxData || !cxData.gas) {
      console.error(`No gas data for complex ${cx.id}`);
      return;
    }

    console.log(`${cx.id} has ${cxData.dates.length} dates, ${cxData.gas.length} gas values`);

    // Format dates for display
    const labels = cxData.dates.map(d => {
      const dt = new Date(d);
      return dt.toLocaleDateString('en-US', {month: 'short', day: 'numeric'});
    });

    if (canvasGas.chart) {
      // Update existing chart
      console.log(`Updating existing gas chart for ${cx.id}`);
      canvasGas.chart.data.labels = labels;
      canvasGas.chart.data.datasets[0].data = cxData.gas;
      canvasGas.chart.rawDates = cxData.dates;
      canvasGas.chart.update();
      canvasGas.classList.add('chart-clickable');
      canvasGas.onclick = (e) => { if (!e.target.closest('.export-btn')) openChartModal(`cx${cx.id}Gas`, cx.name + ' Gas Production'); };
      setupChartContextMenu(`cx${cx.id}Gas`);
      // Update comparison
      if (cxData.gas.length > 1) {
        updateComparison(`comp-cx${cx.id}Gas`, cxData.gas[0], cxData.gas[cxData.gas.length - 1], 'MMSCMD');
      }
    } else {
      // Create new area chart with gradient
      console.log(`Creating new gas chart for ${cx.id}`);
      const ctx = canvasGas.getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 0, 200);
      gradient.addColorStop(0, cx.color + '40'); // 25% opacity at top
      gradient.addColorStop(1, cx.color + '08'); // 3% opacity at bottom

      canvasGas.chart = new Chart(canvasGas, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: cx.name + ' Gas (MMSCMD)',
            data: cxData.gas,
            borderColor: cx.color,
            backgroundColor: gradient,
            fill: true,
            tension: 0.4,
            borderWidth: 2.5,
            pointRadius: 3,
            pointBackgroundColor: cx.color,
            pointBorderColor: '#fff',
            pointBorderWidth: 1.5,
            pointHoverRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          onClick: (event, elements) => {
            if (elements.length > 0) {
              const dataIndex = elements[0].index;
              const label = labels[dataIndex];
              const value = cxData.gas[dataIndex];
              alert(`Date: ${label}\n${cx.name} Gas: ${value.toFixed(3)} MMSCMD`);
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              enabled: true,
              mode: 'index',
              intersect: false,
              backgroundColor: isDark() ? 'rgba(30,30,30,0.95)' : 'rgba(255,255,255,0.95)',
              titleColor: isDark() ? '#fff' : '#000',
              bodyColor: isDark() ? '#fff' : '#000',
              borderColor: isDark() ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
              borderWidth: 1,
              padding: 10,
              callbacks: {
                title: function(context) {
                  return 'Date: ' + context[0].label;
                },
                label: function(context) {
                  return cx.name + ': ' + context.parsed.y.toFixed(3) + ' MMSCMD';
                }
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: '#000', font: { size: 9, weight: 'bold' } },
              border: { color: '#000', width: 1.5 }
            },
            y: {
              grid: { color: grid() },
              ticks: {
                color: '#000',
                font: { size: 9, weight: 'bold' },
                callback: function(value) {
                  return value.toFixed(2);
                }
              },
              border: { color: '#000', width: 1.5 }
            }
          }
        }
      });
      // Store raw dates for export
      canvasGas.chart.rawDates = cxData.dates;
      console.log(`Gas chart created for ${cx.id}`);
      // Add click-to-zoom and right-click context menu
      canvasGas.classList.add('chart-clickable');
      canvasGas.onclick = (e) => { if (!e.target.closest('.export-btn')) openChartModal(`cx${cx.id}Gas`, cx.name + ' Gas Production'); };
      setupChartContextMenu(`cx${cx.id}Gas`);
      // Update comparison for newly created chart
      if (cxData.gas.length > 1) {
        updateComparison(`comp-cx${cx.id}Gas`, cxData.gas[0], cxData.gas[cxData.gas.length - 1], 'MMSCMD');
      }
    }
  });

  console.log('loadComplexWiseTrends completed');
}

// Production Date change handler - updates KPI values for specific date
async function onProdDateChange() {
  const prodDate = document.getElementById('prodDate').value;

  // Fetch data for this specific date
  const summary = await fetchAPI('/dashboard/summary', {start_date: prodDate, end_date: prodDate});
  if (summary && (summary.production || (summary.data && summary.data.production))) {
    const prod = summary.production || summary.data.production;
    document.getElementById('kpi-oil').innerHTML = `${Math.round(prod.total_oil_bopd).toLocaleString()} <span class="kpi-unit">BOPD</span>`;
    document.getElementById('kpi-gas').innerHTML = `${prod.total_gas_mmscm.toFixed(1)} <span class="kpi-unit">MMSCMD</span>`;
    document.getElementById('kpi-wi').innerHTML = `${Math.round(prod.total_wi_bwpd).toLocaleString()} <span class="kpi-unit">BWPD</span>`;

    // Display individual performance values
    const oilPerf = prod.oil_performance_percent || 0;
    const gasPerf = prod.gas_performance_percent || 0;
    document.getElementById('kpi-oil-perf').innerHTML = `Performance: ${oilPerf.toFixed(1)}%`;
    document.getElementById('kpi-oil-perf').className = oilPerf >= 100 ? 'kpi-change up' : (oilPerf >= 90 ? 'kpi-change' : 'kpi-change down');
    document.getElementById('kpi-gas-perf').innerHTML = `Performance: ${gasPerf.toFixed(1)}%`;
    document.getElementById('kpi-gas-perf').className = gasPerf >= 100 ? 'kpi-change up' : (gasPerf >= 90 ? 'kpi-change' : 'kpi-change down');
  }

  // Reload complex-wise chart for the new date if function exists
  if (typeof loadComplexWiseProduction === 'function') {
    await loadComplexWiseProduction();
  }
  if (typeof filterAndRenderLosses === 'function' && lossRawData && lossRawData.records && lossRawData.records.length > 0) {
    filterAndRenderLosses();
  }
}

function loadProduction() {
  const c4 = document.getElementById('c4');
  if (!c4 || c4.chart) return;
  const labels = dates().slice(-10);
  c4.chart = new Chart(c4, {
    type: 'bar',
    data: {
      labels,
      datasets: [
        {label: 'MH North', data: labels.map(() => r(13000, 16000)), backgroundColor: '#15803d', borderRadius: 4},
        {label: 'MH South', data: labels.map(() => r(11000, 14000)), backgroundColor: '#22c55e', borderRadius: 4}
      ]
    },
    options: opts({plugins: {legend: {display: true, position: 'bottom', labels: {color: tick(), usePointStyle: true, font: {size: 9}}}}})
  });

  const t1 = document.getElementById('t1');
  if (t1.dataset.loaded) return;
  t1.dataset.loaded = '1';
  let rows = '';
  for (let i = 0; i < 10; i++) {
    const d = dates()[29 - i];
    const c = i % 2 === 0 ? 'MH North' : 'MH South';
    rows += `<tr><td>${d}</td><td>${c}</td><td>${ri(12000,16000).toLocaleString()}</td><td>${r(60,78).toFixed(1)}</td><td>${ri(22000,28000).toLocaleString()}</td><td>${r(84,92).toFixed(1)}</td></tr>`;
  }
  t1.innerHTML = rows;
}



let lossRawData = { summary: {}, records: [] };
let lossPieInstances = [];

async function loadLosses() {
  if (lossRawData.records.length === 0) {
    try {
      const res = await fetch('losses_data.json');
      lossRawData = await res.json();
      
// Complex names by metric type
const COMPLEXES_BY_METRIC = {
  'oil': ['MHN', 'NQO', 'BHS', 'SCA', 'SHP', 'ICP', 'CL-7', 'WO-16'],
  'gas': ['MHN', 'NQO', 'BHS', 'SCA', 'SHP', 'ICP', 'CL-7', 'WO-16'],
  'wi': ['WIN', 'MNW', 'WIS', 'ICW', 'SHW', 'HRW', 'NLW']
};

// Metric display info
const METRIC_INFO = {
  'oil': { label: 'Oil Loss (Bbls)', color: '#16a34a', bg: 'rgba(22,163,74,0.1)' },
  'gas': { label: 'Gas Loss (MMSCM)', color: '#0284c7', bg: 'rgba(2,132,199,0.1)' },
  'wi': { label: 'WI Loss (Bbls)', color: '#0891b2', bg: 'rgba(8,145,178,0.1)' }
};

async function loadLosses() {
  if (lossRawData.records.length === 0) {
    try {
      const res = await fetch('losses_data.json');
      lossRawData = await res.json();

      // Set default dates from summary
      if (lossRawData.summary.min_date) {
        const startInput = document.getElementById('start');
        const endInput = document.getElementById('end');
        const prodInput = document.getElementById('prodDate');

        if (startInput && !startInput.value) startInput.value = lossRawData.summary.min_date;
        if (endInput && !endInput.value) endInput.value = lossRawData.summary.max_date;
        if (prodInput && !prodInput.value) prodInput.value = lossRawData.summary.max_date;
      }

      updateLossMetricSelect();
      updateLossComplexFilter();
      filterAndRenderLosses();
    } catch (e) {
      console.error("Failed to load losses_data.json:", e);
    }
  } else {
    filterAndRenderLosses();
  }
}

function updateLossMetricSelect() {
  const select = document.getElementById('lossMetricSelect');
  if (!select) return;

  const options = [
    {value: 'oil', label: 'Metric: Oil Loss (Bbls)'},
    {value: 'gas', label: 'Metric: Gas Loss (MMSCM)'},
    {value: 'wi', label: 'Metric: WI Loss (Bbls)'}
  ];

  select.innerHTML = '';
  options.forEach(opt => {
    const el = document.createElement('option');
    el.value = opt.value;
    el.textContent = opt.label;
    select.appendChild(el);
  });

  select.addEventListener('change', filterAndRenderLosses);
}

function updateLossComplexFilter() {
  const filter = document.getElementById('lossCplxFilter');
  if (!filter) return;
  filter.innerHTML = '<option value="">All Complexes</option>';

  const metric = document.getElementById('lossMetricSelect')?.value || 'oil';
  const complexes = COMPLEXES_BY_METRIC[metric] || [];

  complexes.forEach(c => {
    const opt = document.createElement('option');
    opt.value = c;
    opt.textContent = c;
    filter.appendChild(opt);
  });
}

function filterAndRenderLosses() {
  const startD = document.getElementById('start').value;
  const endD = document.getElementById('end').value;
  const metric = document.getElementById('lossMetricSelect')?.value || 'oil';
  const cplxFilter = document.getElementById('lossCplxFilter')?.value || '';

  const records = lossRawData.records;

  // Filter records by date range and complex
  const filtered = records.filter(r => {
    if (startD && r.date < startD) return false;
    if (endD && r.date > endD) return false;
    if (cplxFilter && r.complex !== cplxFilter) return false;
    return true;
  });

  // Calculate totals for KPIs
  let totalOil = 0, totalGas = 0, totalWi = 0;
  filtered.forEach(r => {
    totalOil += r.oil || 0;
    totalGas += r.gas || 0;
    totalWi += r.wi || 0;
  });

  // Update KPIs based on selected metric
  if (metric === 'oil') {
    document.getElementById('lossKpiOil').innerHTML = `${totalOil.toLocaleString(undefined, {minimumFractionDigits:1, maximumFractionDigits:1})} <span class="kpi-unit">Bbls</span>`;
  } else if (metric === 'gas') {
    document.getElementById('lossKpiGas').innerHTML = `${totalGas.toLocaleString(undefined, {minimumFractionDigits:3, maximumFractionDigits:3})} <span class="kpi-unit">MMSCM</span>`;
  } else if (metric === 'wi') {
    document.getElementById('lossKpiWi').innerHTML = `${totalWi.toLocaleString(undefined, {minimumFractionDigits:1, maximumFractionDigits:1})} <span class="kpi-unit">Bbls</span>`;
  }

  document.getElementById('lossTableCount').textContent = filtered.length.toLocaleString();

  // Update trend title
  const titleMap = {oil: 'Oil Loss Trend', gas: 'Gas Loss Trend', wi: 'WI Loss Trend'};
  document.getElementById('lossTrendTitle').textContent = titleMap[metric] || 'Loss Trend';

  // Update complex title
  const cplxTitleMap = {oil: 'Complex - Category & Sub-Category', gas: 'Complex - Category & Sub-Category', wi: 'Complex - Category & Sub-Category'};
  document.getElementById('lossComplexTitle').textContent = cplxFilter ? `${cplxFilter} - Category & Sub-Category` : 'Select a Complex';

  // Render trend chart
  renderLossTrend(filtered, metric, startD, endD);

  // Render pie charts for complexes
  renderLossPies(filtered, metric, cplxFilter);

  // Render table
  renderLossTable(filtered);
}

function renderLossTrend(records, metric, startD, endD) {
  const dailyMap = {};
  records.forEach(r => {
    if (startD && r.date < startD) return;
    if (endD && r.date > endD) return;
    if (!dailyMap[r.date]) dailyMap[r.date] = { oil: 0, gas: 0, wi: 0 };
    dailyMap[r.date].oil += r.oil || 0;
    dailyMap[r.date].gas += r.gas || 0;
    dailyMap[r.date].wi += r.wi || 0;
  });

  const dates = Object.keys(dailyMap).sort();

  const metricVals = {
    'oil': dates.map(d => dailyMap[d].oil),
    'gas': dates.map(d => dailyMap[d].gas),
    'wi': dates.map(d => dailyMap[d].wi)
  };
  const vals = metricVals[metric] || [];

  const formatDates = dates.map(d => {
    const dt = new Date(d);
    return dt.toLocaleDateString('en-US', {month: 'short', day: 'numeric'});
  });

  const c = document.getElementById('lossTrendChart');
  if (!c) return;
  if (c.chart) c.chart.destroy();

  const mi = METRIC_INFO[metric] || METRIC_INFO['oil'];

  c.chart = new Chart(c, {
    type: 'line',
    data: {
      labels: formatDates,
      datasets: [{
        label: mi.label,
        data: vals,
        borderColor: mi.color,
        backgroundColor: mi.bg,
        fill: true,
        tension: 0.3,
        borderWidth: 2,
        pointRadius: 0
      }]
    },
    options: opts({plugins: {legend: {display: false}}})
  });
}

function renderLossPies(records, metric, selectedCplx) {
  const grid = document.getElementById('lossPieGrid');
  if (!grid) return;

  lossPieInstances.forEach(chart => chart.destroy());
  lossPieInstances = [];
  grid.innerHTML = '';

  // Get list of complexes based on metric
  const complexes = selectedCplx ? [selectedCplx] : COMPLEXES_BY_METRIC[metric] || [];

  if (complexes.length === 0) {
    grid.innerHTML = '<div style="text-align: center; color: var(--text-muted); padding: 20px;">No data available for the selected filter</div>';
    return;
  }

  const palette = ['#dc2626', '#f97316', '#d97706', '#0284c7', '#8b5cf6', '#10b981', '#3b82f6', '#eab308'];

  complexes.forEach(cplx => {
    const cplxRecords = records.filter(r => r.complex === cplx);
    if (cplxRecords.length === 0) return;

    // Calculate totals by metric
    let total = 0;
    if (metric === 'oil') total = cplxRecords.reduce((sum, r) => sum + (r.oil || 0), 0);
    else if (metric === 'gas') total = cplxRecords.reduce((sum, r) => sum + (r.gas || 0), 0);
    else if (metric === 'wi') total = cplxRecords.reduce((sum, r) => sum + (r.wi || 0), 0);

    if (total <= 0) return;

    // Category breakdown
    const categories = lossRawData.summary.categories;
    const catData = {};
    categories.forEach(cat => catData[cat] = 0);
    cplxRecords.forEach(r => {
      const val = metric === 'oil' ? r.oil : metric === 'gas' ? r.gas : r.wi;
      catData[r.category || 'Others'] += val || 0;
    });

    // Sub-category breakdown
    const subCategories = lossRawData.summary.sub_categories;
    const subCatData = {};
    subCategories.forEach(sc => subCatData[sc] = 0);
    cplxRecords.forEach(r => {
      const val = metric === 'oil' ? r.oil : metric === 'gas' ? r.gas : r.wi;
      subCatData[r.sub_category || 'Others'] += val || 0;
    });

    // Create chart box
    const box = document.createElement('div');
    box.style.cssText = "background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px;";
    box.innerHTML = `
      <div style="font-weight: 700; font-size: 13px; margin-bottom: 10px; color: var(--text);">
        ${cplx} <span style="font-size: 11px; font-weight: 500; color: var(--text-muted);">(${total.toFixed(1)} ${metric === 'wi' ? 'Bbls' : metric === 'gas' ? 'MMSCM' : 'Bbls'})</span>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <div style="background: rgba(0,0,0,0.02); border-radius: 6px; padding: 8px;">
          <div style="font-size: 10px; color: var(--text-muted); margin-bottom: 6px;">By Category</div>
          <div style="width: 120px; height: 120px; position: relative;"><canvas class="lossPie"></canvas></div>
        </div>
        <div style="background: rgba(0,0,0,0.02); border-radius: 6px; padding: 8px;">
          <div style="font-size: 10px; color: var(--text-muted); margin-bottom: 6px;">By Sub-Category</div>
          <div style="width: 120px; height: 120px; position: relative;"><canvas class="lossPie"></canvas></div>
        </div>
      </div>
    `;
    grid.appendChild(box);

    // Render category pie
    const catCanvas = box.querySelector('.lossPie');
    const catValues = categories.map(cat => catData[cat]);
    const catTotal = catValues.reduce((a, b) => a + b, 0);

    const catPalette = palette.slice(0, categories.length);

    const pieChart = new Chart(catCanvas, {
      type: 'doughnut',
      data: {
        labels: categories,
        datasets: [{
          data: catValues,
          backgroundColor: catPalette,
          borderWidth: 1,
          borderColor: isDark() ? '#1e293b' : '#fff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                const pct = catTotal > 0 ? ((ctx.parsed / catTotal) * 100).toFixed(1) : 0;
                return `${ctx.label}: ${ctx.parsed.toFixed(1)} (${pct}%)`;
              }
            }
          }
        }
      }
    });
    lossPieInstances.push(pieChart);
  });
}

function renderLossTable(records) {
  const tbody = document.getElementById('lossTableBody');
  if (!tbody) return;
  tbody.innerHTML = '';

  records.slice(0, 150).forEach(r => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${r.date}</td>
      <td><strong>${r.complex}</strong></td>
      <td>${r.category}</td>
      <td>${r.sub_category || '—'}</td>
      <td style="color: var(--oil);">${r.oil !== null ? r.oil.toLocaleString() : '—'}</td>
      <td style="color: var(--gas);">${r.gas !== null ? r.gas.toLocaleString(undefined, {minimumFractionDigits:3}) : '—'}</td>
      <td style="color: var(--wi);">${r.wi !== null ? r.wi.toLocaleString() : '—'}</td>
      <td style="max-width: 400px; white-space: normal; font-size: 11px; color: var(--text-muted);">${r.remarks}</td>
      <td style="max-width: 300px; white-space: normal; font-size: 11px;">${r.short_remarks || '—'}</td>
    `;
    tbody.appendChild(tr);
  });
}

window.addEventListener('DOMContentLoaded', async () => {
  const defaultDate = '2026-11-22';
  const startDate = '2026-04-01';

  if (document.getElementById('start') && !document.getElementById('start').value) {
    document.getElementById('start').value = startDate;
  }
  if (document.getElementById('end') && !document.getElementById('end').value) {
    document.getElementById('end').value = defaultDate;
  }
  if (document.getElementById('prodDate') && !document.getElementById('prodDate').value) {
    document.getElementById('prodDate').value = defaultDate;
  }

  if (typeof loadOverview === 'function') {
    await loadOverview(startDate, defaultDate, defaultDate);
  }
});
</script>
</body>
